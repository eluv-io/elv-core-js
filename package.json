{
  "version": "3.1.15",
  "type": "module",
  "scripts": {
    "bump-version": "npm --git-tag-version --no-commit-hooks version patch",
    "serve": "rm -rf node_modules/.vite; vite",
    "serve-db": "firebase emulators:start",
    "build": "rm -rf dist/* ; vite build",
    "build-analyze": "rm -rf dist/* ; ANALYZE_BUNDLE=true vite build",
    "lint": "npm run lint-scss-fix ; npm run lint-scss ; npm run fix-js",
    "lint-show": "npm run lint-scss ; npm run lint-js",
    "lint-js": "./node_modules/.bin/eslint \"src/**/*.js\"",
    "fix-js": "npm run lint-js -- --fix",
    "lint-scss": "npx stylelint \"src/**/*.{css,scss}\"",
    "lint-scss-fix": "npx stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "dependencies": {
    "@eluvio/elv-client-js": "^4.2.39",
    "@mantine/core": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@mantine/modals": "^7.13.4",
    "@ory/client": "1.22.37",
    "@simplewebauthn/browser": "^13.3.0",
    "buffer": "^5.6.0",
    "mobx": "^6.10.2",
    "mobx-react": "^9.0.1",
    "path": "^0.12.7",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-inlinesvg": "^4.1.4",
    "react-markdown": "^8.0.6",
    "react-router": "^6.16.0",
    "react-router-dom": "^6.16.0",
    "url-join": "^4.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.16",
    "babel-eslint": "^10.0.1",
    "csv-parse": "^4.16.3",
    "eslint": "^5.16.0",
    "eslint-plugin-react": "^7.12.4",
    "sass": "^1.86.3",
    "sass-lint": "^1.13.1",
    "sass-loader": "^16.0.5",
    "stylelint": "^15.10.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-order": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
