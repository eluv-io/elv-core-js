{
  "version": "3.1.15",
  "type": "module",
  "scripts": {
    "bump-version": "npm --git-tag-version --no-commit-hooks version patch",
    "serve": "rm -rf node_modules/.vite; vite",
    "serve-db": "firebase emulators:start",
    "build": "rm -rf dist/* ; vite build",
    "build-analyze": "rm -rf dist/* ; ANALYZE_BUNDLE=true vite build",
    "lint": "npm run lint-scss-fix ; npm run lint-scss ; npm run fix-js",
    "lint-show": "npm run lint-scss ; npm run lint-js",
    "lint-js": "./node_modules/.bin/eslint \"src/**/*.js\"",
    "fix-js": "npm run lint-js -- --fix",
    "lint-scss": "npx stylelint \"src/**/*.{css,scss}\"",
    "lint-scss-fix": "npx stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "dependencies": {
    "@eluvio/elv-client-js": "^4.2.43",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/modals": "^9.7.4",
    "@ory/client": "1.22.37",
    "@simplewebauthn/browser": "^13.3.0",
    "mantine-datatable": "^9.4.0",
    "mobx": "^7.1.3",
    "mobx-react": "^10.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-inlinesvg": "^4.1.4",
    "react-markdown": "^8.0.6",
    "url-join": "^4.0.0",
    "uuid": "^9.0.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.13.0",
    "sass": "^1.106.1",
    "sass-embedded": "^1.106.1",
    "stylelint": "^15.10.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-order": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
